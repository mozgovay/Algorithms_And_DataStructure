#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define MAX_EXPR 256

typedef enum { NUM, OP } NodeType;

typedef struct Node {
    NodeType type;
    char op;                // для OP: +, -, *, /
    int value;              // для NUM (целый тип)
    struct Node *left, *right;
} Node;

// Стек для построения дерева
typedef struct {
    Node** data;
    int top;
    int capacity;
} Stack;

Stack* createStack(int cap) {
    Stack* s = (Stack*)malloc(sizeof(Stack));
    s->data = (Node**)malloc(sizeof(Node*) * cap);
    s->top = -1;
    s->capacity = cap;
    return s;
}

void push(Stack* s, Node* n) {
    if (s->top + 1 < s->capacity)
        s->data[++s->top] = n;
}

Node* pop(Stack* s) {
    if (s->top >= 0)
        return s->data[s->top--];
    return NULL;
}

int isEmpty(Stack* s) {
    return s->top == -1;
}

Node* createNumNode(int val) {
    Node* n = (Node*)malloc(sizeof(Node));
    n->type = NUM;
    n->value = val;
    n->left = n->right = NULL;
    return n;
}

Node* createOpNode(char op, Node* left, Node* right) {
    Node* n = (Node*)malloc(sizeof(Node));
    n->type = OP;
    n->op = op;
    n->left = left;
    n->right = right;
    return n;
}

int precedence(char op) {
    if (op == '+' || op == '-') return 1;
    if (op == '*' || op == '/') return 2;
    return 0;
}

void applyOp(Stack* values, char op) {
    Node* right = pop(values);
    Node* left = pop(values);
    push(values, createOpNode(op, left, right));
}

// Построение дерева из выражения (алгоритм Дейкстры)
Node* parseExpression(const char* expr) {
    Stack* values = createStack(MAX_EXPR);
    Stack* ops = createStack(MAX_EXPR);
    
    for (int i = 0; expr[i]; i++) {
        if (isspace(expr[i])) continue;
        
        if (isdigit(expr[i])) {
            int num = 0;
            while (isdigit(expr[i])) {
                num = num * 10 + (expr[i] - '0');
                i++;
            }
            push(values, createNumNode(num));
            i--;
        } 
        else if (expr[i] == '(') {
            push(ops, createOpNode('(', NULL, NULL));
        }
        else if (expr[i] == ')') {
            while (!isEmpty(ops) && ops->data[ops->top]->op != '(') {
                Node* opNode = pop(ops);
                applyOp(values, opNode->op);
                free(opNode);
            }
            if (!isEmpty(ops)) free(pop(ops));
        }
        else if (strchr("+-*/", expr[i])) {
            while (!isEmpty(ops) && ops->data[ops->top]->op != '(' &&
                   precedence(ops->data[ops->top]->op) >= precedence(expr[i])) {
                Node* opNode = pop(ops);
                applyOp(values, opNode->op);
                free(opNode);
            }
            push(ops, createOpNode(expr[i], NULL, NULL));
        }
    }
    
    while (!isEmpty(ops)) {
        Node* opNode = pop(ops);
        applyOp(values, opNode->op);
        free(opNode);
    }
    
    Node* root = pop(values);
    free(values->data); free(values);
    free(ops->data); free(ops);
    return root;
}

Node* simplify(Node* node) {
    if (!node) return NULL;
    
    node->left = simplify(node->left);
    node->right = simplify(node->right);

    if (node->type == OP && node->op == '*') {
        // Проверяем, есть ли 0 в левом или правом поддереве
        if ((node->left && node->left->type == NUM && node->left->value == 0) ||
            (node->right && node->right->type == NUM && node->right->value == 0)) {
            freeTree(node->left);
            freeTree(node->right);
            node->type = NUM;
            node->value = 0;
            node->left = node->right = NULL;
            return node;
        }
    }
    return node;
}

void printTree(Node* node, int level) {
    if (!node) return;
    for (int i = 0; i < level; i++) printf("  ");
    if (node->type == NUM) {
        printf("%d\n", node->value);
    } else {
        printf("%c\n", node->op);
        printTree(node->left, level + 1);
        printTree(node->right, level + 1);
    }
}

void toInfix(Node* node, char* buf, int* pos) {
    if (!node) return;
    if (node->type == NUM) {
        *pos += sprintf(buf + *pos, "%d", node->value);
    } else {
        if (node->left) {
            if (node->left->type == OP && precedence(node->left->op) < precedence(node->op))
                *pos += sprintf(buf + *pos, "(");
            toInfix(node->left, buf, pos);
            if (node->left->type == OP && precedence(node->left->op) < precedence(node->op))
                *pos += sprintf(buf + *pos, ")");
        }
        *pos += sprintf(buf + *pos, " %c ", node->op);
        if (node->right) {
            if (node->right->type == OP && precedence(node->right->op) < precedence(node->op))
                *pos += sprintf(buf + *pos, "(");
            toInfix(node->right, buf, pos);
            if (node->right->type == OP && precedence(node->right->op) < precedence(node->op))
                *pos += sprintf(buf + *pos, ")");
        }
    }
}

void freeTree(Node* node) {
    if (!node) return;
    freeTree(node->left);
    freeTree(node->right);
    free(node);
}

int main() {
    char expr[MAX_EXPR];
    printf("Программа упрощения арифметических выражений\n");
    printf("Введите арифметическое выражение (с *, +, -, / и целыми числами):\n");
    printf("Примеры: 5 * 0 + 3, (2 + 3) * 0, 0 * (4 + 5)\n");
    printf("-> ");
    fgets(expr, MAX_EXPR, stdin);
    expr[strcspn(expr, "\n")] = '\0';
    
    printf("\nИсходное выражение: %s\n", expr);
    
    Node* root = parseExpression(expr);
    printf("\nДерево исходного выражения:\n");
    printTree(root, 0);
    
    Node* simplified = simplify(root);
    printf("\nУпрощённое дерево (убраны произведения с 0):\n");
    printTree(simplified, 0);
    
    char outBuf[MAX_EXPR];
    int pos = 0;
    toInfix(simplified, outBuf, &pos);
    printf("\nУпрощённое выражение: %s\n", outBuf);
    
    freeTree(simplified);
    printf("Программа завершена.\n");
    
    return 0;
}
